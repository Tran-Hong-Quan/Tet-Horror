    m_Localized: Circuit breaker
    m_Metadata:
      m_Items: []
  - m_Id: 11548433736671232
    m_Localized: Screwdriver
    m_Metadata:
      m_Items: []
  - m_Id: 11945748192436224
    m_Localized: Mini speaker
    m_Metadata:
      m_Items: []
  - m_Id: 13107209237307392
    m_Localized: Put the meat here
    m_Metadata:
      m_Items: []
  - m_Id: 13108772261470208
    m_Localized: Pork
    m_Metadata:
      m_Items: []
  - m_Id: 16627535120310272
    m_Localized: It seems the house's electrical system is still not quite stable
      after the storm.
    m_Metadata:
      m_Items: []
  - m_Id: 16628975679184896
    m_Localized: Could you please check the circuit breaker for me?
    m_Metadata:
      m_Items: []
  - m_Id: 18520895846227968
    m_Localized: Ah, my head hurts so much!
    m_Metadata:
      m_Items: []
  - m_Id: 18522969589817344
    m_Localized: I can barely breathe, I've been beaten and my hands and neck are
      tied.
    m_Metadata:
      m_Items: []
  - m_Id: 18523115354464256
    m_Localized: Sister, please help me, I can't breath
    m_Metadata:
      m_Items: []
  - m_Id: 18523185550336000
    m_Localized: I'm also in too much pain, I can't untie you
    m_Metadata:
      m_Items: []
  - m_Id: 18523249744158720
    m_Localized: But it's okay, I have a way
    m_Metadata:
      m_Items: []
  - m_Id: 18523453667024896
    m_Localized: Hang in there, I will find a way to help you
    m_Metadata:
      m_Items: []
