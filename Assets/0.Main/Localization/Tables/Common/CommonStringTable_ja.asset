    m_Localized: "\u4ECA\u671D\u65E9\u304F\u3001\u5C71\u9593\u90E8\u306E\u4F4F\u5B85\u5730\u3092\u7A81\u5982\u8972\u3063\u305F\u58CA\u6EC5\u7684\u306A\u9244\u7832\u6C34\u306B\u3088\u308A\u3001\u6751\u5168\u4F53\u304C\u308F\u305A\u304B\u6570\u5206\u3067\u58CA\u6EC5\u72B6\u614B\u3068\u306A\u308A\u307E\u3057\u305F\u3002\u4F4F\u6C11\u304C\u7720\u3063\u3066\u3044\u308B\u9593\u306B\u3001\u5C71\u9802\u304B\u3089\u5927\u91CF\u306E\u6CE5\u3068\u5CA9\u304C\u6D41\u308C\u843D\u3061\u3001\u4F4F\u6C11\u306F\u53CD\u5FDC\u3059\u308B\u9593\u3082\u306A\u304F\u8972\u308F\u308C\u307E\u3057\u305F\u3002\r\n\r\n\u73FE\u5728\u307E\u3067\u306B\u3001\u5F53\u5C40\u306F\u6570\u5341\u4EBA\u306E\u6B7B\u4EA1\u3068\u884C\u65B9\u4E0D\u660E\u8005\u3092\u78BA\u8A8D\u3057\u3066\u3044\u307E\u3059\u3002\u73FE\u5834\u306E\u5BB6\u5C4B\u3084\u8CA1\u7523\u306F\u3001\u6570\u30E1\u30FC\u30C8\u30EB\u3082\u306E\u6CE5\u3068\u74E6\u792B\u306E\u4E0B\u306B\u57CB\u3082\u308C\u3066\u3044\u307E\u3059\u3002\u5927\u898F\u6A21\u306A\u571F\u7802\u5D29\u308C\u306E\u305F\u3081\u3001\u73FE\u5834\u3078\u306E\u30A2\u30AF\u30BB\u30B9\u306F\u5B8C\u5168\u306B\u906E\u65AD\u3055\u308C\u3066\u304A\u308A\u3001\u6551\u52A9\u6D3B\u52D5\u306F\u6975\u3081\u3066\u56F0\u96E3\u3092\u6975\u3081\u3066\u3044\u307E\u3059\u3002\r\n\r\n\u5F53\u5C40\u306F\u3001\u9589\u3058\u8FBC\u3081\u3089\u308C\u305F\u4EBA\u3005\u306E\u635C\u7D22\u306B\u5168\u529B\u3092\u5C3D\u304F\u3057\u3066\u3044\u307E\u3059\u304C\u3001\u5929\u5019\u306E\u60AA\u5316\u304C\u7D9A\u304F\u4E2D\u3001\u5E0C\u671B\u306F\u4F9D\u7136\u3068\u3057\u3066\u8584\u3044\u72B6\u6CC1\u3067\u3059\u3002"
