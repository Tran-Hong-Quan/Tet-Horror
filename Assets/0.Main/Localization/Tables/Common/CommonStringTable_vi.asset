  m_TableData:
  - m_Id: 69878554624
    m_Localized: "T\u1EA3i \n\u1EA3nh l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 1337813313658880
    m_Localized: "Nh\u1EB7t kh\xF4 g\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1343791639699456
    m_Localized: "\u0110\u1ED5i k\u1EB9p t\xF3c"
    m_Metadata:
      m_Items: []
  - m_Id: 2591977293357056
    m_Localized: "Ch\u1ECDn qu\xE0 t\u1EBFt cho ch\u1ECB g\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7299982463213568
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 7300775446716416
    m_Localized: "Kh\xF4 g\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 7302586824007680
    m_Localized: Karaoke microphone
    m_Metadata:
      m_Items: []
  - m_Id: 7302716922929152
    m_Localized: Con dao
    m_Metadata:
      m_Items: []
  - m_Id: 7302814398554112
    m_Localized: "B\xE1nh k\u1EB9o"
    m_Metadata:
      m_Items: []
  - m_Id: 7303485948567552
    m_Localized: "Qu\u1EA7n \xE1o"
    m_Metadata:
      m_Items: []
  - m_Id: 8765026250137600
    m_Localized: "B\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 8765135423676416
    m_Localized: "Ch\u1ECB g\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 8765510646112256
    m_Localized: "Ch\u1ECB c\u1EA3m \u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 8766130551660544
    m_Localized: "Ch\xFAng ta \u0103n c\u01A1m t\u1EBFt th\xF4i n\xE0o"
    m_Metadata:
      m_Items: []
  - m_Id: 8766361762668544
    m_Localized: "N\u0103m nay ch\u1EC9 c\xF2n 2 ch\u1ECB em ch\xFAng ta th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 8766813971554304
    m_Localized: "Ch\u1ECB \u0111\xE3 l\xE0m r\u1EA5t nhi\u1EC1u th\u1ECBt trong
      b\u1EBFp, em l\u1EA5y h\u1ED9 ch\u1ECB nh\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 8767207778951168
    m_Localized: "Sao em bi\u1EBFt ch\u1ECB \u0111ang b\u1ECB thi\u1EBFu d\u1EE5ng
      c\u1EE5 b\u1EBFp n\xE0y nh\u1EC9?"
    m_Metadata:
      m_Items: []
  - m_Id: 8767536859848704
    m_Localized: "Em r\u1EA5t hi\u1EC3u c\u1EA3m x\xFAc c\u1EE7a m\u1ED9t ng\u01B0\u1EDDi
      \u1EDF nh\xE0 m\u1ED9t m\xECnh \u0111\u1EA5y!"
    m_Metadata:
      m_Items: []
  - m_Id: 8912996912209920
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 8926395792498688
    m_Localized: "L\xE0m xong ra l\u1EA5y L\xEC x\xEC nh\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 9477458811559936
    m_Localized: "C\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 11304134264627200
    m_Localized: Album
    m_Metadata:
      m_Items: []
  - m_Id: 11307993565372416
    m_Localized: "H\xE3y xem album v\xE0 \u0111\u1EBFm s\u1ED1 l\u01B0\u1EE3ng sinh
      v\u1EADt s\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 11315771566596096
    m_Localized: "TH\u1EA2M K\u1ECACH L\u0168 QU\xC9T: M\u1ED8T NG\xD4I L\xC0NG B\u1ECA
      X\xD3A S\u1ED4 TRONG \u0110\xCAM\nTH\u1EDCI S\u1EF0 | 12/10/2025"
    m_Metadata:
      m_Items: []
  - m_Id: 11452953644113920
    m_Localized: "R\u1EA1ng s\xE1ng nay, m\u1ED9t tr\u1EADn l\u0169 qu\xE9t kinh
      ho\xE0ng \u0111\xE3 b\u1EA5t ng\u1EDD \u0111\u1ED5 \u1EADp xu\u1ED1ng m\u1ED9t
      khu d\xE2n c\u01B0 v\xF9ng cao, san ph\u1EB3ng to\xE0n b\u1ED9 ng\xF4i l\xE0ng
      ch\u1EC9 trong v\xE0i ph\xFAt. D\xF2ng th\xE1c b\xF9n \u0111\xE1 t\u1EEB \u0111\u1EC9nh
      n\xFAi tr\xE0n xu\u1ED1ng d\u1ED3n d\u1EADp trong l\xFAc ng\u01B0\u1EDDi d\xE2n
      \u0111ang ng\u1EE7 say, khi\u1EBFn h\u1ECD kh\xF4ng k\u1ECBp tr\u1EDF tay.\n\nT\xEDnh
      \u0111\u1EBFn th\u1EDDi \u0111i\u1EC3m hi\u1EC7n t\u1EA1i, c\u01A1 quan ch\u1EE9c
      n\u0103ng x\xE1c nh\u1EADn \u0111\xE3 c\xF3 h\xE0ng ch\u1EE5c ng\u01B0\u1EDDi
      ch\u1EBFt v\xE0 m\u1EA5t t\xEDch. To\xE0n b\u1ED9 nh\xE0 c\u1EEDa v\xE0 t\xE0i
      s\u1EA3n t\u1EA1i hi\u1EC7n tr\u01B0\u1EDDng \u0111\xE3 b\u1ECB v\xF9i l\u1EA5p
      d\u01B0\u1EDBi l\u1EDBp b\xF9n \u0111\u1EA5t s\xE2u h\xE0ng m\xE9t. L\u1ED1i
      v\xE0o khu v\u1EF1c n\xE0y hi\u1EC7n b\u1ECB chia c\u1EAFt ho\xE0n to\xE0n
      do s\u1EA1t l\u1EDF nghi\xEAm tr\u1ECDng, khi\u1EBFn c\xF4ng t\xE1c c\u1EE9u
      h\u1ED9 g\u1EB7p r\u1EA5t nhi\u1EC1u kh\xF3 kh\u0103n.\n\nL\u1EF1c l\u01B0\u1EE3ng
      ch\u1EE9c n\u0103ng \u0111ang n\u1ED7 l\u1EF1c h\u1EBFt m\xECnh \u0111\u1EC3
      t\xECm ki\u1EBFm nh\u1EEFng ng\u01B0\u1EDDi c\xF2n k\u1EB9t l\u1EA1i, tuy nhi\xEAn
      hy v\u1ECDng mong manh khi th\u1EDDi ti\u1EBFt v\u1EABn ti\u1EBFp t\u1EE5c
      di\u1EC5n bi\u1EBFn x\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 11470498296111104
    m_Localized: "T\u1EDD b\xE1o c\u0169"
    m_Metadata:
      m_Items: []
  - m_Id: 11531237992046592
    m_Localized: "C\u1EA7n c\xF4ng c\u1EE5 \u0111\u1EC3 m\u1EDF"
    m_Metadata:
      m_Items: []
  - m_Id: 11532036868546560
    m_Localized: "B\u1EADt c\u1EA7u dao"
    m_Metadata:
      m_Items: []
  - m_Id: 11532242511077376
    m_Localized: "C\u1EA7u dao \u0111i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 11548433736671232
    m_Localized: "Tua v\xEDt"
    m_Metadata:
      m_Items: []
  - m_Id: 11945748192436224
    m_Localized: Loa Mini
    m_Metadata:
      m_Items: []
  - m_Id: 13107209237307392
    m_Localized: "\u0110\u1EC3 th\u1ECBt l\xEAn \u0111\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 13108772261470208
    m_Localized: "Th\u1ECBt l\u1EE3n"
    m_Metadata:
      m_Items: []
  - m_Id: 16627535120310272
    m_Localized: "C\xF3 v\u1EBB h\u1EC7 th\u1ED1ng \u0111i\u1EC7n c\u1EE7a nh\xE0
      v\u1EABn ch\u01B0a \u1ED5n l\u1EAFm sau c\u01A1n b\xE3o \u0111\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 16628975679184896
    m_Localized: "Em \u0111i ki\u1EC3m tra c\u1EA7u dao gi\xFAp ch\u1ECB nh\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 18520895846227968
    m_Localized: "Ahh, \u0111au \u0111\u1EA7u qu\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 18522969589817344
    m_Localized: "Kh\xF3 th\u1EDF qu\xE1, m\xECnh v\u1EEBa b\u1ECB \u0111\xE1nh,
      v\u1EEBa b\u1ECB tr\xF3i tay v\xE0 c\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 18523115354464256
    m_Localized: "Ch\u1ECB g\xE1i, ch\u1ECB gi\xFAp em v\u1EDBi, em kh\xF3 th\u1EDF
      qu\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 18523185550336000
    m_Localized: "Ch\u1ECB c\u0169ng \u0111au qu\xE1, kh\xF4ng th\u1EC3 c\u1EDFi
      tr\xF3i cho em \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 18523249744158720
    m_Localized: "Nh\u01B0ng kh\xF4ng sao, ch\u1ECB \u0111\xE3 c\xF3 c\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 18523453667024896
    m_Localized: "C\u1ED1 g\u1EAFng l\xEAn, em s\u1EBD t\xECm c\xE1ch gi\xFAp ch\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 18889042583494656
    m_Localized: "V\u1EC1 \u0103n t\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 18889163488501760
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 18889372121571328
    m_Localized: "C\u1EA3m \u01A1n c\xE1c b\u1ED1"
    m_Metadata:
      m_Items: []
  - m_Id: 18889591538196480
    m_Localized: "K\u1EBFt th\xFAc ngh\u1EC9 t\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 18889735201497088
    m_Localized: "Ti\u1EBFp t\u1EE5c \u0103n t\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 19259579834966016
    m_Localized: "Di chuy\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 19259736420917248
    m_Localized: "Ph\xEDm c\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 19259890867773440
    m_Localized: "T\u01B0\u01A1ng t\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 19260012326428672
    m_Localized: "Th\u1EA3 \u0111\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 19260682412630016
    m_Localized: "Nh\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 19271135868100608
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 19273718628229120
    m_Localized: "\u0110\u1ED9 nh\u1EA1y"
    m_Metadata:
      m_Items: []
  - m_Id: 19428734391427072
    m_Localized: "V\u1EC1 Menu"
    m_Metadata:
      m_Items: []
  - m_Id: 19429119248179200
    m_Localized: "T\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 19918870975750144
    m_Localized: "X\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 19992513449697280
    m_Localized: "\u0110\u1EEBng \nnh\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 19993188611006464
    m_Localized: "C\u1EA3m \u01A1n c\xE1c b\u1EA1n \u0111\xE3 ch\u01A1i demo game
      c\u1EE7a m\xECnh.\nGame s\u1EBD \u0111\u01B0\u1EDBc ti\u1EBFp t\u1EE5c ph\xE1t
      tri\u1EC3n n\u1EBFu \u0111\u01B0\u1EE3c ch\xFA \xFD v\xE0 \u1EE7ng h\u1ED9
      \u0111\xE1ng k\u1EC3.\nDanh s\xE1ch c\xE1c b\u1ED1: Hi\u1EC7n t\u1EA1i ch\u01B0a
      c\xF3 b\u1ED1 n\xE0o nu\xF4i con c\u1EA3 :(((\nN\u1EBFu b\u1EA1n n\xE0o mu\u1ED1n
      \u0111\u01B0\u1EE3c v\xE0o game, vinh danh, l\xE0m b\u1ED1, l\xE0m b\u1EA1n
      g\xE1i m\xECnh,... b\u1EA1n c\xF3 th\u1EC3 donate m\xECnh qua Momo v\xE0 nh\u1EAFn
      tin cho m\xECnh, m\xECnh c\u1EA3m \u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 20729170440364032
    m_Localized: "\u1EA8n/Hi\u1EC7n"
    m_Metadata:
      m_Items: []
  references:
    version: 2
