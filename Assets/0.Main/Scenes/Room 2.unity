--- !u!114 &610493192
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 610493189}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 1
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 15
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "R\u1EA1ng s\xE1ng nay, m\u1ED9t tr\u1EADn l\u0169 qu\xE9t kinh ho\xE0ng
    \u0111\xE3 b\u1EA5t ng\u1EDD \u0111\u1ED5 \u1EADp xu\u1ED1ng m\u1ED9t khu d\xE2n
    c\u01B0 v\xF9ng cao, san ph\u1EB3ng to\xE0n b\u1ED9 ng\xF4i l\xE0ng ch\u1EC9
    trong v\xE0i ph\xFAt. D\xF2ng th\xE1c b\xF9n \u0111\xE1 t\u1EEB \u0111\u1EC9nh
    n\xFAi tr\xE0n xu\u1ED1ng d\u1ED3n d\u1EADp trong l\xFAc ng\u01B0\u1EDDi d\xE2n
    \u0111ang ng\u1EE7 say, khi\u1EBFn h\u1ECD kh\xF4ng k\u1ECBp tr\u1EDF tay.\n\nT\xEDnh
    \u0111\u1EBFn th\u1EDDi \u0111i\u1EC3m hi\u1EC7n t\u1EA1i, c\u01A1 quan ch\u1EE9c
    n\u0103ng x\xE1c nh\u1EADn \u0111\xE3 c\xF3 h\xE0ng ch\u1EE5c ng\u01B0\u1EDDi
    ch\u1EBFt v\xE0 m\u1EA5t t\xEDch. To\xE0n b\u1ED9 nh\xE0 c\u1EEDa v\xE0 t\xE0i
    s\u1EA3n t\u1EA1i hi\u1EC7n tr\u01B0\u1EDDng \u0111\xE3 b\u1ECB v\xF9i l\u1EA5p
    d\u01B0\u1EDBi l\u1EDBp b\xF9n \u0111\u1EA5t s\xE2u h\xE0ng m\xE9t. L\u1ED1i
    v\xE0o khu v\u1EF1c n\xE0y hi\u1EC7n b\u1ECB chia c\u1EAFt ho\xE0n to\xE0n do
    s\u1EA1t l\u1EDF nghi\xEAm tr\u1ECDng, khi\u1EBFn c\xF4ng t\xE1c c\u1EE9u h\u1ED9
    g\u1EB7p r\u1EA5t nhi\u1EC1u kh\xF3 kh\u0103n.\n\nL\u1EF1c l\u01B0\u1EE3ng ch\u1EE9c
    n\u0103ng \u0111ang n\u1ED7 l\u1EF1c h\u1EBFt m\xECnh \u0111\u1EC3 t\xECm ki\u1EBFm
    nh\u1EEFng ng\u01B0\u1EDDi c\xF2n k\u1EB9t l\u1EA1i, tuy nhi\xEAn hy v\u1ECDng
    mong manh khi th\u1EDDi ti\u1EBFt v\u1EABn ti\u1EBFp t\u1EE5c di\u1EC5n bi\u1EBFn
    x\u1EA5u."
